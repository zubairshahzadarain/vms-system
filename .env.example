# Copy to .env and adjust. Used by docker-compose.
POSTGRES_USER=vms
POSTGRES_PASSWORD=vms_secret
POSTGRES_DB=vms

JWT_SECRET=change-me-in-production-7f8a9b2c
JWT_EXPIRES_IN=12h

# Web UI will be available on this host port
WEB_PORT=8080

# Storage quota for recordings/snapshots (GB). Oldest recordings are pruned above this.
MAX_STORAGE_GB=2

# Keyframe thumbnail interval in seconds (30-60 recommended)
KEYFRAME_INTERVAL_SECONDS=30

# Optional: relay one external HLS/RTSP source into the simulator as a 5th
# demo camera (rtsp://simulator:8554/external1), useful for a demo with real
# footage instead of only synthetic test patterns. Leave blank to skip.
# Only use a stream you have the right to relay.
EXTERNAL_RELAY_URL=
