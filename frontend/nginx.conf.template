server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST API
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        # HTTP/1.1 required: Azure Container Apps' Envoy ingress rejects the
        # nginx proxy default of HTTP/1.0 with 426 Upgrade Required.
        proxy_http_version 1.1;
        # $proxy_host, not $host: Azure Container Apps ingress (Envoy) routes
        # by Host header, so it must name the target app, not the original site.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
    }

    # Protected media: HLS live streams, recordings, snapshots, keyframes.
    location /media/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/media/;
        proxy_http_version 1.1;
        # $proxy_host, not $host: Azure Container Apps ingress (Envoy) routes
        # by Host header, so it must name the target app, not the original site.
        proxy_set_header Host $proxy_host;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-cache";
    }

    # Socket.IO (realtime dashboard / command center / event feed)
    location /socket.io/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # $proxy_host, not $host: Azure Container Apps ingress (Envoy) routes
        # by Host header, so it must name the target app, not the original site.
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 86400;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
